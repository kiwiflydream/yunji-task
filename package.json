{
  "name": "yunji-task",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "deploy": "vite build && pnpm db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:smoke": "vite build && node test/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "vite build",
    "preview": "vite build && vite preview"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "【必填】后台登录密码，请设置独立强密码。部署后使用 ADMIN_USERNAME（默认 admin）和此密码登录。"
      },
      "ENCRYPTION_KEY": {
        "description": "【必填】用于加密任务变量，必须是 32 字节随机密钥的 Base64 编码。用 `openssl rand -base64 32` 生成并妥善保存，丢失或更换后已存变量将无法解密。"
      },
      "ADMIN_AUTH_MODE": {
        "description": "后台登录方式，默认 `basic`，首次部署保留默认即可。部署后可按文档切换为 Cloudflare Access。"
      },
      "ADMIN_USERNAME": {
        "description": "后台登录用户名，默认 `admin`，可直接保留。"
      }
    }
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.3",
    "croner": "^10.0.1",
    "echarts": "^6.1.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.110.0"
  }
}
